{
  "name": "dealer-logic-ultra-stack",
  "version": "2.0.0",
  "description": "Dealer Logic Ultra Stack - Complete Automotive Dealership Intelligence Platform",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --watch src/backend --ext ts,js --exec ts-node src/backend/server.ts",
    "dev:frontend": "next dev -p 3001",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "next build",
    "start": "node dist/server/index.js",
    "test": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/server/database/migrate.js",
    "seed": "node dist/server/database/seed.js",
    "sync-agents": "npm run build:backend && node scripts/sync-agents.js sync",
    "docker:build": "docker build -t dealer-logic-ultra .",
    "docker:run": "docker run -p 3000:3000 dealer-logic-ultra"
  },
  "keywords": [
    "dealer",
    "automotive",
    "CRM",
    "AI",
    "voice",
    "analytics",
    "ROI",
    "pricing",
    "telephony",
    "dashboard"
  ],
  "author": "Dealer Logic",
  "license": "UNLICENSED",
  "dependencies": {
    "@elevenlabs/client": "^0.6.2",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@tanstack/react-query": "^5.65.0",
    "@tanstack/react-table": "^8.20.6",
    "@types/helmet": "^0.0.48",
    "axios": "^1.11.0",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "chart.js": "^4.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.2",
    "framer-motion": "^11.15.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.2",
    "next-auth": "^4.24.11",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
