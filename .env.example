# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dealer_logic_ultra"
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this"
SESSION_SECRET="your-session-secret-change-this"
NEXTAUTH_SECRET="your-nextauth-secret-change-this"
NEXTAUTH_URL="http://localhost:3001"

# Voice AI Integration
VAPI_API_KEY="your-vapi-api-key"
VAPI_PHONE_NUMBER_ID="your-vapi-phone-number"
VAPI_ASSISTANT_ID="your-vapi-assistant-id"
VAPI_WEBHOOK_SECRET="your-vapi-webhook-secret"

# ElevenLabs & ConvAI Integration
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
CONVAI_API_KEY="your-convai-api-key"
CONVAI_CHARACTER_ID="your-character-id"

# CRM Integrations
HUBSPOT_API_KEY=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
PIPEDRIVE_API_KEY=""
ZOHO_API_KEY=""

# Twilio Configuration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email Service
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@dealerlogic.ai"

# Analytics
GOOGLE_ANALYTICS_ID=""
MIXPANEL_TOKEN=""

# Application
NODE_ENV="development"
PORT=3000
FRONTEND_PORT=3001
APP_URL="http://localhost:3001"
API_URL="http://localhost:3000"

# Feature Flags
ENABLE_VOICE_AI=true
ENABLE_ANALYTICS=true
ENABLE_PRICING_MODULE=true
ENABLE_ROI_CALCULATOR=true
ENABLE_MULTI_TENANT=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs/dealer-logic.log"

# AWS (Optional for S3, etc)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-west-2"
AWS_S3_BUCKET=""

# Stripe (for payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""